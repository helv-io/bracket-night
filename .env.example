# Copy to backend/.env (or export in your process manager / Docker).
# Never commit real secrets.

NODE_ENV=development

# --- Live game / server ---
MAX_PLAYERS=10

# SQLite bracket templates (not live game state — that is in-memory only)
# Defaults: ./config and ./config/bracket.db in development
# DB_FOLDER=./config
# DB_PATH=./config/bracket.db
# DATA_PATH=./data

# --- Socket.IO CORS ---
# Comma-separated allowlist. In development, defaults to http://localhost:3000.
# In production (same-origin static frontend served by Express), leave unset.
# FRONTEND_ORIGIN is an alias for CORS_ORIGIN.
# CORS_ORIGIN=https://brackets.example.com
# FRONTEND_ORIGIN=https://brackets.example.com

# --- Expensive API protection (AI + image search) ---
# Optional shared secret. If set, require header X-API-Secret (or ?api_secret=).
# Recommended for internet-exposed deploys. Rate limits still apply when unset.
# API_SECRET=change-me
# BRACKET_API_SECRET=change-me
#
# If you set API_SECRET and use the Next.js /new UI, also set the matching
# public build-time var so the browser can send the header:
# NEXT_PUBLIC_API_SECRET=change-me

# --- OpenAI (required in production for GET /api/ai/:topic; fails closed if missing) ---
# OPENAI_API_KEY=
# OPENAI_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Image search / proxy ---
# SEARXNG_HOST=searx.example.com
# IMGPROXY_HOST=imgproxy.example.com
# IMGPROXY_KEY=
# IMGPROXY_SALT=
