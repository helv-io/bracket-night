{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "module": "CommonJS",
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "../engine/src/**/*.ts", "../backend/src/**/*.ts"]
}
