{
  "name": "bracket-night",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "npm run lint -w frontend",
    "lint:fix": "npm run lint -w frontend -- --fix",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck -w backend",
    "clean": "rimraf dist",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build": "npm run build:frontend && npm run build:backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev": "npx npm-run-all --parallel dev:backend dev:frontend",
    "start:frontend": "npm run build -w frontend",
    "start:backend": "npm start -w backend",
    "start": "npm run start:frontend && npm run start:backend"
  },
  "private": false,
  "workspaces": [
    "backend",
    "frontend"
  ]
}
